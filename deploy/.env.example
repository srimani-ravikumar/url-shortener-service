# Copy to deploy/.env (git-ignored) and change the values. Compose reads it automatically.

# Scrambles the ID counter into short codes. At least 16 characters. Keep it the same for the life of the data:
# changing it later can make new codes collide with existing ones. Generate one with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
FEISTEL_SECRET=

# Host port of the public entry point (nginx). Short links are built as http://localhost:<port>/<code>.
PUBLIC_PORT=8080

# Leave empty to turn telemetry export off. With `--profile observability`, use the collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
